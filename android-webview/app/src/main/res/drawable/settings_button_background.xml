<?xml version="1.0" encoding="utf-8"?>
<!-- Фон кнопки «Настройки»: полупрозрачная плашка со скруглением + ripple. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/settings_button_ripple">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="11dp" />
            <solid android:color="@color/settings_button_solid" />
            <stroke
                android:width="1dp"
                android:color="@color/settings_button_stroke" />
        </shape>
    </item>
</ripple>
