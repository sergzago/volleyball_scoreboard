<?xml version="1.0" encoding="utf-8"?>
<!-- Иконка приложения: фото волейбольного мяча b0.webp (из корня репозитория).
     inset 18dp вписывает квадрат 999×999 в safe zone adaptive-иконки
     (канвас 108dp, видимая зона ~72dp), по краям виден ic_launcher_background. -->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:drawable="@drawable/b0"
    android:insetLeft="18dp"
    android:insetTop="18dp"
    android:insetRight="18dp"
    android:insetBottom="18dp" />
